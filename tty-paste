#!/bin/bash

CLIPFILE="${HOME}/.ttyclip"

# Prefer wl-paste if in Wayland and available
if [ "$XDG_SESSION_TYPE" = "wayland" ] && command -v wl-paste >/dev/null 2>&1; then
    wl-paste
# Fallback: use xclip if available
elif [ "$XDG_SESSION_TYPE" = "x11" ] command -v xclip >/dev/null 2>&1; then
    xclip -o -selection clipboard
else
    # Final fallback: read from a file
    cat "$CLIPFILE"
fi


