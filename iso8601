#!/usr/bin/python

import sys
from datetime import datetime

if len(sys.argv) < 2:
    print("Usage: iso8601 DD/MM/YYYY")
    sys.exit(1)

input_date = sys.argv[1]

try:
    iso_date = datetime.strptime(input_date, "%d/%m/%Y").isoformat()
    print(iso_date)
except ValueError:
    print(f"Error: '{input_date}' is not a valid DD/MM/YYYY date.")
    sys.exit(1)
