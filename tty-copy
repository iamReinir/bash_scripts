#!/bin/bash

CLIPFILE="${HOME}/.ttyclip"

# Read stdin into a variable or file first
input=$(cat)

# Try clipboard utilities in order
if [ "$XDG_SESSION_TYPE" = "wayland" ] && command -v wl-copy >/dev/null 2>&1; then
    printf "%s" "$input" | wl-copy
elif [ "$XDG_SESSION_TYPE" = "x11" ] && command -v xclip >/dev/null 2>&1; then
    printf "%s" "$input" | xclip -selection clipboard
fi
# Fallback: write to a file
printf "%s" "$input" > "$CLIPFILE"

